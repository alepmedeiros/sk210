unit SensorBobinaManager;

interface

uses
  System.SysUtils, System.Classes, Androidapi.Helpers, FMX.Dialogs,
  sk210.bridge.topwise.AidlPrinter, DeviceServiceManager;

type
  TSensorBobinaManager = class
  private
    FPrinterManager: JAidlPrinter;
    function GetPaperState: Integer;
    function IsCoverOpen: Boolean;
    function GetPrinterState: Integer;
  public
    constructor Create;
    procedure CheckPrinterStatus;
  end;

implementation

{ TSensorBobinaManager }

constructor TSensorBobinaManager.Create;
begin
  inherited Create;
  // Obtém o gerenciador da impressora do DeviceServiceManager
  FPrinterManager := TDeviceServiceManager.GetInstance.GetPrintManager;

  if FPrinterManager = nil then
    raise Exception.Create('Gerenciador da impressora não disponível.');
end;

function TSensorBobinaManager.GetPaperState: Integer;
begin
  try
    Result := FPrinterManager.getPosPrintPaperState;
  except
    on E: Exception do
    begin
      ShowMessage('Erro ao verificar o estado do papel: ' + E.Message);
      Result := -1;
    end;
  end;
end;

function TSensorBobinaManager.IsCoverOpen: Boolean;
begin
  try
    Result := FPrinterManager.isPosPrinterCoverOpen;
  except
    on E: Exception do
    begin
      ShowMessage('Erro ao verificar a tampa da impressora: ' + E.Message);
      Result := False;
    end;
  end;
end;

function TSensorBobinaManager.GetPrinterState: Integer;
begin
  try
    Result := FPrinterManager.getPrinterState;
  except
    on E: Exception do
    begin
      ShowMessage('Erro ao verificar o estado da impressora: ' + E.Message);
      Result := -1;
    end;
  end;
end;

procedure TSensorBobinaManager.CheckPrinterStatus;
var
  PaperState, PrinterState: Integer;
  CoverOpen: Boolean;
begin
  // Verifica o estado do papel
  PaperState := GetPaperState;

  // Verifica o estado da tampa da impressora
  CoverOpen := IsCoverOpen;

  // Verifica o estado geral da impressora
  PrinterState := GetPrinterState;

  if PaperState = 0 then
    ShowMessage('O papel está quase acabando.')
  else if PrinterState = $01 then
    ShowMessage('O papel acabou.')
  else if (PrinterState = $00) and (not CoverOpen) then
    ShowMessage('Há papel suficiente.');
end;

end.

